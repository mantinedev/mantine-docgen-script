{
  "name": "mantine-docgen-script",
  "description": "A script to generate props table data based on TypeScript props definition. Specific to Mantine components.",
  "packageManager": "yarn@4.18.1",
  "version": "3.0.0",
  "type": "module",
  "author": "Vitaly Rtishchev <rtivital@gmail.com>",
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "typescript",
    "docgen"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mantinedev/mantine-docgen-script.git"
  },
  "bugs": {
    "url": "https://github.com/mantinedev/mantine-docgen-script/issues"
  },
  "homepage": "https://github.com/mantinedev/mantine-docgen-script#readme",
  "types": "./dist/index.d.ts",
  "exports": "./dist/index.js",
  "scripts": {
    "clean": "rimraf dist",
    "generate-dts": "tsc --project tsconfig.build.json",
    "build": "rolldown -c rolldown.config.js && npm run generate-dts",
    "pack:test": "tsx scripts/pack-test",
    "format:check": "oxfmt --check .",
    "format:write": "oxfmt --write .",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src scripts tests --max-warnings=0",
    "vitest": "vitest run",
    "vitest:watch": "vitest watch",
    "vitest:coverage": "vitest run --coverage",
    "knip": "knip",
    "test": "npm run format:check && npm run typecheck && npm run lint && npm run vitest && npm run build && npm run pack:test && npm run knip",
    "test:docgen": "tsx tests/write-docgen-fixture.ts",
    "release": "npm test && tsx scripts/release"
  },
  "dependencies": {
    "chalk": "^6.0.1",
    "fs-extra": "^11.4.1",
    "react-docgen-typescript": "^2.4.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/signale": "^1",
    "@types/yargs": "^17.0.35",
    "@vitest/coverage-v8": "^5.0.5",
    "execa": "^10.2.0",
    "knip": "^6.42.0",
    "new-github-release-url": "^2.0.0",
    "open": "^11.0.4",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "react": "^19.3.1",
    "rimraf": "^6.1.3",
    "rolldown": "^1.2.14",
    "signale": "^1.4.0",
    "simple-git": "^4.0.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "version-next": "^1.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "yargs": "^18.2.0"
  }
}
